# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.

# Canonical origin used for metadata, canonical URLs, sitemap and structured data.
# Optional; defaults to https://distortionlens.com.
NEXT_PUBLIC_SITE_URL=https://distortionlens.com

# Contact form (optional). The form is only shown when both of these are set;
# otherwise the contact page falls back to email links.
# Create an API key at https://resend.com and verify the sending domain there.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="DistortionLens <noreply@distortionlens.com>"

# Inbox that receives contact form messages. Optional; defaults to contact@distortionlens.com.
CONTACT_TO_EMAIL=
